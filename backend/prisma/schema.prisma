// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════
// BRANCHES
// ═══════════════════════════════════════
model Branch {
  id             String   @id @default(uuid())
  name           String   @unique
  code           String   @unique
                 // "DXB", "SHJ", "AUH"
  address        String
  phone          String
  email          String
  whatsapp       String
  mapUrl         String?
  operatingHours String?
  trn            String?
  isActive       Boolean  @default(true)
  permissions    String?  @default("[\"dashboard\",\"schedule\",\"registration\",\"payments\",\"coaches\",\"reminders\"]")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  admins         Admin[]
  coaches        Coach[]
  students       Student[]
  schedules      Schedule[]
  payments       Payment[]
  notifications  Notification[]
  reminders      Reminder[]
  cancellations  Cancellation[]
  freezings      Freezing[]
  reviews        Review[]
  expenses       Expense[]
}

// ═══════════════════════════════════════
// ADMIN USERS
// ═══════════════════════════════════════
model Admin {
  id        String    @id @default(uuid())
  username  String    @unique
  email     String    @unique
  password  String
  name      String
  phone     String?
  role      AdminRole @default(STAFF)
  branchId  String?
  isActive  Boolean   @default(true)
  lastLogin DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  branch       Branch?       @relation(fields: [branchId], references: [id])
  reminders    Reminder[]
  activityLogs ActivityLog[]
  expenses     Expense[]     @relation("AdminExpenses")
  refreshTokens RefreshToken[] @relation("AdminRefreshTokens")
}

enum AdminRole {
  SUPER_ADMIN
  STAFF
}

// ═══════════════════════════════════════
// STUDENTS
// ═══════════════════════════════════════
model Student {
  id                      String          @id @default(uuid())
  studentId               String          @unique
  name                    String
  age                     Int
  gender                  Gender
  email                   String
  phone                   String
  password                String
  level                   String
  category                StudentCategory
  packageType             String
  trn                     String?         // Added TRN field
  branchId                String
  status                  StudentStatus   @default(PENDING)
  membershipStartDate     DateTime?
  membershipExpiryDate    DateTime?
  registrationDate        DateTime        @default(now())
  assessmentPassDate      DateTime?
  nextAssessmentDate      DateTime?
  renewalCount            Int             @default(0)
  discount                Float           @default(0)
  privacyPolicyAccepted   Boolean         @default(false)
  privacyPolicyAcceptedAt DateTime?
  profileImage            String?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  branch             Branch                  @relation(fields: [branchId], references: [id])
  scheduleSlots      ScheduleSlot[]
  attendanceRecords  AttendanceRecord[]
  payments           Payment[]
  studentNotifications StudentNotification[]
  cancellations      Cancellation[]
  freezings          Freezing[]
  membershipHistory  MembershipHistory[]
  classCancellations ClassCancellation[]
  coachAssignments   CoachStudentAssignment[]
  reviews            Review[]
  refreshTokens      RefreshToken[]          @relation("StudentRefreshTokens")
}

enum Gender {
  MALE
  FEMALE
}

enum StudentCategory {
  TODDLER
  KID
  ADULT
}



enum StudentStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
  FROZEN
}

// ═══════════════════════════════════════
// REFRESH TOKENS (for secure logout)
// ═══════════════════════════════════════
model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  adminId   String?
  studentId String?
  expiresAt DateTime
  revoked   Boolean  @default(false)
  revokedAt DateTime?
  createdAt DateTime @default(now())

  admin   Admin?   @relation("AdminRefreshTokens", fields: [adminId], references: [id], onDelete: Cascade)
  student Student? @relation("StudentRefreshTokens", fields: [studentId], references: [id], onDelete: Cascade)
}

// ═══════════════════════════════════════
// PASSWORD RESET TOKENS
// ═══════════════════════════════════════
model PasswordResetToken {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ═══════════════════════════════════════
// MEMBERSHIP HISTORY
// ═══════════════════════════════════════
model MembershipHistory {
  id          String           @id @default(uuid())
  studentId   String
  packageType String
  startDate   DateTime
  expiryDate  DateTime
  totalClasses Int
  classesUsed  Int             @default(0)
  freeClasses  Int             @default(0)
  oldClasses   Int             @default(0)  // Carryover classes from previous expired package
  status      MembershipStatus
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  student Student @relation(fields: [studentId], references: [id])
}

enum MembershipStatus {
  ACTIVE
  COMPLETED
  EXPIRED
  CANCELLED
  FROZEN
}

// ═══════════════════════════════════════
// COACHES
// ═══════════════════════════════════════
model Coach {
  id       String  @id @default(uuid())
  coachId  String  @unique
  name     String
  email    String
  phone    String
  gender   Gender  @default(MALE)
  branchId String
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch             Branch                  @relation(fields: [branchId], references: [id])
  schedules          Schedule[]
  studentAssignments CoachStudentAssignment[]
}

model CoachStudentAssignment {
  id         String   @id @default(uuid())
  coachId    String
  studentId  String
  assignedAt DateTime @default(now())

  coach   Coach   @relation(fields: [coachId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([coachId, studentId])
}

// ═══════════════════════════════════════
// SCHEDULE SYSTEM
// ═══════════════════════════════════════
model Schedule {
  id       String   @id @default(uuid())
  date     DateTime @db.Date
  branchId String
  coachId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch Branch @relation(fields: [branchId], references: [id])
  coach  Coach  @relation(fields: [coachId], references: [id])
  slots  ScheduleSlot[]

  @@unique([date, branchId, coachId])
}

model ScheduleSlot {
  id           String  @id @default(uuid())
  scheduleId   String
  timeSlot     String
  slotPosition Int
  studentId    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  schedule         Schedule          @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  student          Student?          @relation(fields: [studentId], references: [id])
  attendanceRecord AttendanceRecord?

  @@unique([scheduleId, timeSlot, slotPosition])
}

// ═══════════════════════════════════════
// ATTENDANCE
// ═══════════════════════════════════════
model AttendanceRecord {
  id               String           @id @default(uuid())
  scheduleSlotId   String           @unique
  studentId        String
  date             DateTime         @db.Date
  status           AttendanceStatus
  markedBy         String?
  notificationSent Boolean          @default(false)
  comment          String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  scheduleSlot ScheduleSlot @relation(fields: [scheduleSlotId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId], references: [id])
}

enum AttendanceStatus {
  ATTENDED
  ABSENT
  INFORMED
  FROZEN
  NOT_MARKED
}

// ═══════════════════════════════════════
// PAYMENTS & INVOICES
// ═══════════════════════════════════════
model Payment {
  id               String           @id @default(uuid())
  invoiceNumber    String           @unique
  studentId        String
  branchId         String
  amount           Float
  discount         Float            @default(0)
  totalAmount      Float
  paidAmount       Float
  pendingAmount    Float            @default(0)
  paymentMode      PaymentMode
  paymentDate      DateTime
  status           PaymentStatus
  trn              String?
  isInstallment    Boolean          @default(false)
  packageType      String
  registrationType RegistrationType
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  student      Student       @relation(fields: [studentId], references: [id])
  branch       Branch        @relation(fields: [branchId], references: [id])
  installments Installment[]
}

model Installment {
  id        String        @id @default(uuid())
  paymentId String
  amount    Float
  dueDate   DateTime
  paidDate  DateTime?
  status    PaymentStatus
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}

enum PaymentMode {
  CASH
  CARD
  ONLINE
}

enum PaymentStatus {
  PAID
  PENDING
  PARTIAL
  OVERDUE
  REFUNDED
}

enum RegistrationType {
  NEW
  RENEW
}

// ═══════════════════════════════════════
// NOTIFICATIONS
// ═══════════════════════════════════════
model Notification {
  id       String             @id @default(uuid())
  branchId String?
  title    String
  message  String
  type     NotificationType
  sentBy   String?
  sentTo   NotificationTarget
  targetId String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  branch               Branch?               @relation(fields: [branchId], references: [id])
  studentNotifications StudentNotification[]
}

model StudentNotification {
  id             String    @id @default(uuid())
  notificationId String
  studentId      String
  isRead         Boolean   @default(false)
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId], references: [id])

  @@unique([notificationId, studentId])
}

enum NotificationType {
  HOLIDAY
  CLASS_UPDATE
  OFFER
  FEE_REMINDER
  ASSESSMENT_RESULT
  MISSED_CLASS
  WELCOME
  GENERAL
  CLASS_CANCELLED
}

enum NotificationTarget {
  INDIVIDUAL
  ALL
  BRANCH
  COACH_STUDENTS
  PENDING_FEES
}

// ═══════════════════════════════════════
// REMINDERS
// ═══════════════════════════════════════
model Reminder {
  id             String           @id @default(uuid())
  createdById    String
  branchId       String
  reminderFor    ReminderFor
  targetBranchId String?
  contactEmail   String?
  contactPhone   String?
  message        String
  scheduledDate  DateTime
  scheduledTime  String
  priority       ReminderPriority @default(MEDIUM)
  status         ReminderStatus   @default(PENDING)
  completedAt    DateTime?
  snoozedUntil   DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  createdBy Admin  @relation(fields: [createdById], references: [id])
  branch    Branch @relation(fields: [branchId], references: [id])
}

enum ReminderFor {
  MYSELF
  OTHER_BRANCH
  SPECIFIC_PERSON
  STUDENT
}

enum ReminderPriority {
  HIGH
  MEDIUM
  LOW
}

enum ReminderStatus {
  PENDING
  SENT
  COMPLETED
  OVERDUE
  SNOOZED
}

// ═══════════════════════════════════════
// CANCELLATIONS
// ═══════════════════════════════════════
model Cancellation {
  id                String       @id @default(uuid())
  studentId         String
  branchId          String?
  cancellationDate  DateTime
  classesUsed       Int
  classesTotal      Int
  classesRemaining  Int
  reason            String?
  refundStatus      RefundStatus @default(NONE)
  refundAmount      Float?
  cancelledBy       String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  student Student @relation(fields: [studentId], references: [id])
  branch  Branch? @relation(fields: [branchId], references: [id])
}

enum RefundStatus {
  NONE
  PENDING
  PROCESSED
  REJECTED
}

// ═══════════════════════════════════════
// FREEZINGS
// ═══════════════════════════════════════
model Freezing {
  id              String         @id @default(uuid())
  studentId       String
  branchId        String?
  freezeStartDate DateTime
  freezeEndDate   DateTime
  duration        Int
  comment         String?
  status          FreezingStatus @default(FROZEN)
  unfrozenAt      DateTime?
  frozenBy        String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  student Student @relation(fields: [studentId], references: [id])
  branch  Branch? @relation(fields: [branchId], references: [id])
}

enum FreezingStatus {
  FROZEN
  UNFROZEN
}

// ═══════════════════════════════════════
// CLASS CANCELLATIONS (by students)
// ═══════════════════════════════════════
model ClassCancellation {
  id          String   @id @default(uuid())
  studentId   String
  classDate   DateTime @db.Date
  classTime   String
  reason      String?
  cancelledAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id])
}

// ═══════════════════════════════════════
// ACTIVITY LOG
// ═══════════════════════════════════════
model ActivityLog {
  id         String   @id @default(uuid())
  adminId    String
  action     String
  entityType String
  entityId   String?
  details    String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  admin Admin @relation(fields: [adminId], references: [id])
}

// ═══════════════════════════════════════
// SETTINGS
// ═══════════════════════════════════════
model Setting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ═══════════════════════════════════════
// REVIEWS (Student Ratings)
// ═══════════════════════════════════════
model Review {
  id        String   @id @default(uuid())
  studentId String
  branchId  String?
  rating    Int      // 1 to 5
  text      String?
  createdAt DateTime @default(now())

  student Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  branch  Branch?  @relation(fields: [branchId], references: [id])
}

// ═══════════════════════════════════════
// EXPENSES (Financial Tracking)
// ═══════════════════════════════════════
model Expense {
  id          String          @id @default(uuid())
  title       String
  category    ExpenseCategory
  amount      Float
  date        DateTime        @db.Date
  branchId    String?
  notes       String?
  createdById String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  branch    Branch? @relation(fields: [branchId], references: [id])
  createdBy Admin   @relation("AdminExpenses", fields: [createdById], references: [id])
}

enum ExpenseCategory {
  COACH_SALARY
  FACILITY_RENT
  UTILITIES
  EQUIPMENT
  MARKETING
  ADMIN_COST
  OTHER
}
