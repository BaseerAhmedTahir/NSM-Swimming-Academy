# ═══════════════════════════════════════
# SERVER
# ═══════════════════════════════════════
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# ═══════════════════════════════════════
# DATABASE (PostgreSQL — Neon.tech free tier)
# ═══════════════════════════════════════
DATABASE_URL="postgresql://neondb_owner:npg_2iDptWSP0zLK@ep-gentle-breeze-ag9g33r7-pooler.c-2.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# ═══════════════════════════════════════
# JWT SECRETS
# ═══════════════════════════════════════
JWT_ACCESS_SECRET=your-access-secret-min-64-chars-long-replace-this
JWT_REFRESH_SECRET=your-refresh-secret-min-64-chars-long-replace-this
JWT_ACCESS_EXPIRY=1h
JWT_REFRESH_EXPIRY=30d

# ═══════════════════════════════════════
# CORS
# ═══════════════════════════════════════
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:19006

# ═══════════════════════════════════════
# EMAIL (Resend free tier OR Gmail SMTP)
# ═══════════════════════════════════════
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_d3ruEfWr_KL1uX4HcJbsoUq2Vu6MWedEq
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
