# ═══════════════════════════════════════
# RATE LIMITING & APP SETTINGS
# ═══════════════════════════════════════
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=5000
LOG_LEVEL=debug
REMINDER_POLL_INTERVAL_SECONDS=60
CANCELLATION_THRESHOLD_HOURS=24
MAX_STUDENTS_PER_SLOT=6
DEFAULT_TIME_SLOTS=4:00 PM,5:00 PM,6:00 PM,7:00 PM,8:00 PM
